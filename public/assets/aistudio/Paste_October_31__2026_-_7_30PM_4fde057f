<script>
  // Filter Tabs Micro-interaction
  const filterChips = document.querySelectorAll('.filter-chip');
  const routineCards = document.querySelectorAll('.routine-card');

  filterChips.forEach(chip => {
    chip.addEventListener('click', () => {
      filterChips.forEach(c => {
        c.classList.remove('bg-surface-container-highest', 'text-primary');
        c.classList.add('bg-surface-container', 'text-on-surface-variant');
      });

      chip.classList.remove('bg-surface-container', 'text-on-surface-variant');
      chip.classList.add('bg-surface-container-highest', 'text-primary');

      const targetFilter = chip.getAttribute('data-filter');

      routineCards.forEach(card => {
        const category = card.getAttribute('data-category');
        if (targetFilter === 'all' || category === targetFilter) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Action Button Micro-Feedback (Añadir al día)
  const addButtons = document.querySelectorAll('.btn-add-today');
  const toast = document.getElementById('toast-notification');
  let toastTimer;

  addButtons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const originalText = btn.innerHTML;
      btn.innerHTML = `<span class="material-symbols-outlined text-[16px] animate-spin">refresh</span><span>INSPECCIONANDO...</span>`;
      
      setTimeout(() => {
        btn.innerHTML = `<span class="material-symbols-outlined text-[16px]">done</span><span>SINCRONIZADO</span>`;
        btn.classList.add('bg-primary-container');

        // Show Toast
        if (toast) {
          toast.classList.remove('opacity-0', 'pointer-events-none');
          toast.classList.add('opacity-100');
          clearTimeout(toastTimer);
          toastTimer = setTimeout(() => {
            toast.classList.remove('opacity-100');
            toast.classList.add('opacity-0', 'pointer-events-none');
          }, 2400);
        }

        setTimeout(() => {
          btn.innerHTML = originalText;
          btn.classList.remove('bg-primary-container');
        }, 1800);
      }, 500);
    });
  });
